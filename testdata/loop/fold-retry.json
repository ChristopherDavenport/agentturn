{
  "name": "fold-retry",
  "description": "A request the server refuses as longer than the model's window, before anything of the answer opened, is never sent again unchanged: the loop asks the transform for a fold and, the input having changed, sends the folded request as a retry within the turn, reported by model_retry.",
  "rules": ["#the-model-call", "#the-request", "#retry"],
  "config": {"model": "m", "fold": [
    {"type": "message", "role": "developer", "content": [{"type": "input_text", "text": "summary: the user asked about a"}]},
    {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "and b"}]}
  ]},
  "model": [
    {"error": {"message": "the request is longer than the window", "code": "context_length_exceeded"}},
    {"id": "resp_2", "output": [
      {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "a and b"}]}
    ]}
  ],
  "runs": [
    {
      "prompt": [
        {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "a"}]},
        {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "and b"}]}
      ],
      "expect": {
        "events": [
          {"type": "run_start"},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "turn_start", "turn": 1,
           "request": {"input": [{"type": "message", "role": "user"}, {"type": "message", "role": "user"}]}},
          {"type": "model_retry", "turn": 1, "attempt": 1, "error": true,
           "request": {"input": [
             {"type": "message", "role": "developer", "content": [{"type": "input_text", "text": "summary: the user asked about a"}]},
             {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "and b"}]}
           ]}},
          {"type": "item_start", "response_id": "resp_2"}, {"type": "item_end", "response_id": "resp_2"},
          {"type": "response_end", "turn": 1, "response": {"id": "resp_2"}},
          {"type": "turn_end", "turn": 1},
          {"type": "run_end", "reason": "done", "error": false}
        ],
        "transcript": [
          {"type": "message", "role": "user"},
          {"type": "message", "role": "user"},
          {"type": "message", "role": "assistant"}
        ]
      }
    }
  ]
}
