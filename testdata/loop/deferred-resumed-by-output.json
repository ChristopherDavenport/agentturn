{
  "name": "deferred-resumed-by-output",
  "description": "A deferred call ends the run input_required with the call pending as deferred and nothing run; a resume that supplies its output appends it and calls the model.",
  "rules": ["#preflight", "#ending-a-run", "#pending-calls-and-resume"],
  "config": {"model": "m"},
  "tools": [{"name": "delete"}],
  "decisions": {"call_1": {"action": "defer", "reason": "ask the user"}},
  "model": [
    {"id": "resp_1", "output": [
      {"type": "function_call", "call_id": "call_1", "name": "delete", "arguments": "{\"path\":\"a\"}"}
    ]},
    {"id": "resp_2", "output": [
      {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "understood"}]}
    ]}
  ],
  "runs": [
    {
      "prompt": [{"type": "message", "role": "user", "content": [{"type": "input_text", "text": "delete a"}]}],
      "expect": {
        "events": [
          {"type": "run_start", "source": "input"},
          {"type": "item_start", "item": {"type": "message", "role": "user"}},
          {"type": "item_end", "item": {"type": "message", "role": "user"}},
          {"type": "turn_start", "turn": 1},
          {"type": "item_start", "item": {"type": "function_call", "call_id": "call_1"}},
          {"type": "item_end", "item": {"type": "function_call", "call_id": "call_1"}},
          {"type": "response_end", "turn": 1},
          {"type": "tool_start", "call_id": "call_1", "decision": {"action": "defer", "reason": "ask the user"}},
          {"type": "tool_end", "call_id": "call_1", "deferred": true, "blocked": false, "reason": "ask the user", "error": false},
          {"type": "turn_end", "turn": 1, "tool_results": [{}]},
          {"type": "run_end", "reason": "input_required", "cause": "", "error": false,
           "pending": [{"call_id": "call_1", "reason": "deferred"}]}
        ],
        "transcript": [
          {"type": "message", "role": "user"},
          {"type": "function_call", "call_id": "call_1"}
        ]
      }
    },
    {
      "resume": [{"call_id": "call_1", "output": "the user said no"}],
      "expect": {
        "events": [
          {"type": "run_start", "source": "resume"},
          {"type": "item_start", "turn": 0, "item": {"type": "function_call_output", "call_id": "call_1"}},
          {"type": "item_end", "turn": 0, "item": {"type": "function_call_output", "call_id": "call_1", "output": "the user said no"}},
          {"type": "turn_start", "turn": 1,
           "inputs": [{"type": "function_call_output", "call_id": "call_1"}],
           "arrived": [{"mode": "resume"}]},
          {"type": "item_start", "item": {"type": "message", "role": "assistant"}},
          {"type": "item_end", "item": {"type": "message", "role": "assistant"}},
          {"type": "response_end", "turn": 1, "response": {"id": "resp_2"}},
          {"type": "turn_end", "turn": 1, "tool_results": []},
          {"type": "run_end", "reason": "done", "error": false, "pending": []}
        ],
        "transcript": [
          {"type": "message", "role": "user"},
          {"type": "function_call", "call_id": "call_1"},
          {"type": "function_call_output", "call_id": "call_1", "output": "the user said no"},
          {"type": "message", "role": "assistant"}
        ]
      }
    }
  ]
}
