{
  "name": "deliver",
  "description": "A delivery made from inside the run, while a call runs, does not wait: it joins the run as a steer does, is appended after the batch's outputs and turn_end, and the turn that takes it reports it with mode deliver rather than steer.",
  "rules": ["#queues", "#the-turn", "#order"],
  "config": {"model": "m"},
  "tools": [{"name": "build", "result": {"output": "started"}}],
  "model": [
    {"id": "resp_1", "output": [
      {"type": "function_call", "call_id": "call_1", "name": "build", "arguments": "{}"}
    ]},
    {"id": "resp_2", "output": [
      {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "the build passed"}]}
    ]}
  ],
  "runs": [
    {
      "prompt": [{"type": "message", "role": "user", "content": [{"type": "input_text", "text": "build it"}]}],
      "deliver_at": {
        "event": {"type": "tool_start", "call_id": "call_1"},
        "items": [{"type": "message", "role": "user", "content": [{"type": "input_text", "text": "the build passed"}]}]
      },
      "expect": {
        "events": [
          {"type": "run_start"},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "turn_start", "turn": 1},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "response_end"},
          {"type": "tool_start", "call_id": "call_1"},
          {"type": "tool_dispatch", "call_id": "call_1"},
          {"type": "tool_end", "call_id": "call_1"},
          {"type": "item_start", "item": {"type": "function_call_output", "call_id": "call_1"}},
          {"type": "item_end", "item": {"type": "function_call_output", "call_id": "call_1"}},
          {"type": "turn_end", "turn": 1},
          {"type": "item_start", "turn": 1, "item": {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "the build passed"}]}},
          {"type": "item_end", "turn": 1, "item": {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "the build passed"}]}},
          {"type": "turn_start", "turn": 2,
           "inputs": [{"type": "function_call_output", "call_id": "call_1"}, {"type": "message", "role": "user"}],
           "arrived": [{"mode": "tool"}, {"mode": "deliver"}]},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "response_end"},
          {"type": "turn_end", "turn": 2},
          {"type": "run_end", "reason": "done", "error": false}
        ],
        "transcript": [
          {"type": "message", "role": "user"},
          {"type": "function_call", "call_id": "call_1"},
          {"type": "function_call_output", "call_id": "call_1"},
          {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "the build passed"}]},
          {"type": "message", "role": "assistant"}
        ]
      }
    }
  ]
}
