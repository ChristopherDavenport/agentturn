{
  "name": "nested-replays-an-ended-call",
  "description": "When an approval runs a cut call again, a nested call its earlier execution made that ended is made again under the ID it had and returns the result it returned, without its tool running, the decision hook asked or a tool_dispatch.",
  "rules": ["#nested-calls", "#pending-calls-and-resume", "#cancellation"],
  "config": {"model": "m"},
  "tools": [
    {"name": "run_code", "replay": "safe", "sequence": [
      {"invoke": {"name": "read", "arguments": {"path": "a"}}, "wait": "cancel"},
      {"invoke": {"name": "read", "arguments": {"path": "a"}}, "output": "the script printed contents of a"}
    ]},
    {"name": "read", "result": {"output": "contents of a"}}
  ],
  "model": [
    {"id": "resp_1", "output": [
      {"type": "function_call", "call_id": "call_1", "name": "run_code", "arguments": "{}"}
    ]},
    {"id": "resp_2", "output": [
      {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "done"}]}
    ]}
  ],
  "runs": [
    {
      "prompt": [{"type": "message", "role": "user", "content": [{"type": "input_text", "text": "run the script"}]}],
      "cancel_at": {"type": "tool_end", "name": "read"},
      "expect": {
        "events": [
          {"type": "run_start", "source": "input"},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "turn_start", "turn": 1},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "response_end", "turn": 1},
          {"type": "tool_start", "call_id": "call_1", "parent": ""},
          {"type": "tool_dispatch", "call_id": "call_1"},
          {"type": "tool_start", "call_id": {"$bind": "read"}, "name": "read", "args": {"path": "a"}, "parent": "call_1", "replayed": false},
          {"type": "tool_dispatch", "call_id": {"$bind": "read"}, "parent": "call_1"},
          {"type": "tool_end", "call_id": {"$bind": "read"}, "parent": "call_1", "error": false, "cut": false, "result": {"output": "contents of a"}},
          {"type": "tool_end", "call_id": "call_1", "error": true, "cut": true},
          {"type": "run_end", "reason": "aborted", "error": true,
           "pending": [{"call_id": "call_1", "reason": "aborted", "invoked": [
             {"call_id": {"$bind": "read"}, "parent": "call_1", "name": "read", "args": {"path": "a"}, "dispatched": true, "ended": true}
           ]}]}
        ]
      }
    },
    {
      "resume": [{"call_id": "call_1", "approve": true}],
      "expect": {
        "events": [
          {"type": "run_start", "source": "resume"},
          {"type": "tool_start", "turn": 0, "call_id": "call_1", "decision": {"action": "allow", "reason": "run again: safe"}},
          {"type": "tool_dispatch", "turn": 0, "call_id": "call_1"},
          {"type": "tool_start", "turn": 0, "call_id": {"$bind": "read"}, "name": "read", "parent": "call_1", "replayed": true, "decision": null},
          {"type": "tool_end", "turn": 0, "call_id": {"$bind": "read"}, "parent": "call_1", "replayed": true, "error": false, "result": {"output": "contents of a"}},
          {"type": "tool_end", "turn": 0, "call_id": "call_1", "error": false, "result": {"output": "the script printed contents of a"}},
          {"type": "item_start", "item": {"type": "function_call_output", "call_id": "call_1"}},
          {"type": "item_end", "item": {"type": "function_call_output", "call_id": "call_1"}},
          {"type": "turn_start", "turn": 1},
          {"type": "item_start"}, {"type": "item_end"},
          {"type": "response_end", "turn": 1},
          {"type": "turn_end", "turn": 1},
          {"type": "run_end", "reason": "done", "error": false, "pending": []}
        ]
      }
    }
  ],
  "executions": {"run_code": 2, "read": 1}
}
